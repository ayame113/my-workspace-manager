mkremote myrepo b1 b2 b3
exec ws clone file://$WORK/remotes/myrepo.git
exec ws new t1
exec ws worktree add --task t1 --repo myrepo --branch b1
exec ws worktree add --task t1 --repo myrepo --branch b2
env A=$WS_ROOT/tasks/t1/myrepo--b1
env B=$WS_ROOT/tasks/t1/myrepo--b2
exec sh $WORK/make-files.sh
symlink $B/node_modules/x/link.js -> index.js

exec sh $WORK/describe.sh
cp stdout $WORK/before.txt

# dry-run は何も変更せず、インデックスも作らない
exec ws compact --dry-run
stdout '^走査しました: 7 ファイル\nハッシュ計算: 7 ファイル\n置き換え対象: 3 ファイル\(削減見込み 0.0 MiB\)。--dry-run のため変更していません\n$'
exec sh $WORK/describe.sh
cmp stdout $WORK/before.txt
! exists $WS_ROOT/.compact-index

# 内容が同じで mode も同じものだけが置き換えられる。内容・mode・symlink は変わらない
exec ws compact
stdout '^走査しました: 7 ファイル\nハッシュ計算: 7 ファイル\n置き換え: 3 ファイル\(削減見込み 0.0 MiB\)\n$'
exec sh $WORK/describe.sh
cp stdout $WORK/after.txt
exec awk -f $WORK/changed.awk $WORK/before.txt $WORK/after.txt
cmpenv stdout $WORK/want-changed.txt
exec readlink $B/node_modules/x/link.js
stdout '^index.js$'
! exists $A/node_modules/x/.ws-compact-index.js
exec sh -c 'ls -A $A/node_modules/x $B/node_modules/x | grep -c ws-compact || true'
stdout '^0$'

# 2 回目は変更が無いのでハッシュ計算も置き換えも 0 件
exec ws compact
stdout '^走査しました: 7 ファイル\nハッシュ計算: 0 ファイル\n置き換え: 0 ファイル\(削減見込み 0.0 MiB\)\n'

# 書き換えたファイルだけが処理し直される
exec sh -c 'printf "a1\n" > $B/node_modules/x/diff.js'
exec ws compact
stdout '^走査しました: 7 ファイル\nハッシュ計算: 1 ファイル\n置き換え: 1 ファイル\(削減見込み 0.0 MiB\)\n'

# 新しい worktree の追加分
exec ws worktree add --task t1 --repo myrepo --branch b3
exec sh -c 'mkdir -p $WS_ROOT/tasks/t1/myrepo--b3/node_modules/x && printf "same\n" > $WS_ROOT/tasks/t1/myrepo--b3/node_modules/x/index.js && printf "only here\n" > $WS_ROOT/tasks/t1/myrepo--b3/node_modules/x/unique.js'
exec ws compact
stdout '^走査しました: 9 ファイル\nハッシュ計算: 1 ファイル\n置き換え: 1 ファイル\(削減見込み 0.0 MiB\)\n'

# インデックスを消すと全件処理に戻る
rm $WS_ROOT/.compact-index
exec ws compact
stdout '^走査しました: 9 ファイル\nハッシュ計算: 8 ファイル\n置き換え: 5 ファイル\(削減見込み 0.0 MiB\)\n'

# 中断で残った一時ファイルは走査時に削除され、インデックスの一時ファイルは次回の保存で上書きされる
exec sh -c 'printf junk > $A/node_modules/x/.ws-compact-index.js; printf junk > $WS_ROOT/.compact-index.tmp'
exec ws compact
! exists $A/node_modules/x/.ws-compact-index.js
! exists $WS_ROOT/.compact-index.tmp
stdout '^走査しました: 9 ファイル\n'

# 壊れたインデックスは捨てて全件処理する
exec sh -c 'echo garbage > $WS_ROOT/.compact-index'
exec ws compact
stdout '^走査しました: 9 ファイル\nハッシュ計算: 8 ファイル\n'

-- make-files.sh --
mk() { mkdir -p "$(dirname "$1")"; printf "$2" > "$1"; chmod "$3" "$1"; }
mk $A/node_modules/x/index.js 'same\n' 644
mk $A/node_modules/x/node_modules/y/index.js 'same\n' 644
mk $A/node_modules/x/diff.js 'a1\n' 644
mk $A/node_modules/x/bin.sh 'same\n' 755
mk $A/node_modules/x/empty '' 644
mk $A/lib/outside.js 'same\n' 644
mk $B/node_modules/x/index.js 'same\n' 644
mk $B/node_modules/x/diff.js 'b2\n' 644
mk $B/node_modules/x/bin.sh 'same\n' 644
mk $B/node_modules/x/empty '' 644
-- describe.sh --
for f in \
  $A/node_modules/x/index.js $A/node_modules/x/node_modules/y/index.js $A/node_modules/x/diff.js \
  $A/node_modules/x/bin.sh $A/node_modules/x/empty $A/lib/outside.js \
  $B/node_modules/x/index.js $B/node_modules/x/diff.js $B/node_modules/x/bin.sh $B/node_modules/x/empty; do
  echo "$f $(stat -f '%i %Lp' "$f") $(cat "$f" | tr '\n' '/')"
done
-- changed.awk --
FNR == NR { inode[$1] = $2; rest[$1] = $3 " " $4; next }
{
  if (rest[$1] != $3 " " $4) print "content or mode changed: " $1
  if (inode[$1] != $2) { sub(/.*\/root\/tasks\//, "", $1); print "replaced: " $1 }
}
-- want-changed.txt --
replaced: t1/myrepo--b1/node_modules/x/node_modules/y/index.js
replaced: t1/myrepo--b2/node_modules/x/index.js
replaced: t1/myrepo--b2/node_modules/x/bin.sh
