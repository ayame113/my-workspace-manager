import {
  "moonbitlang/core/env",
  "moonbitlang/core/path",
  "moonbitlang/core/async/fs",
  "my-workspace-manager/ws/internal/errors",
  "my-workspace-manager/ws/internal/git",
  "my-workspace-manager/ws/internal/layout",
  "my-workspace-manager/ws/internal/sys",
}

supported_targets = "-all+native"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async/fs" ],
)

// ws は async タスクをキャンセルしないので、catch での後始末で問題ない

warnings = "-fragile_catch_all"
