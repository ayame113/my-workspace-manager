///|
struct NpmFixture {
  sandbox : Sandbox
  npm_log : String
  tasks : String
}

///|
async fn find_in_path(sandbox : Sandbox, command : String) -> String {
  for directory in sandbox.env.get("PATH").unwrap_or("").split(":") {
    let candidate = "\{directory}/\{command}"
    if @fs.exists(candidate) {
      return candidate
    }
  }
  fail("\{command} not found in PATH")
}

///|
async fn make_package(
  sandbox : Sandbox,
  name : String,
  version : String,
) -> Unit {
  let source = "\{sandbox.root}/pkgs/\{name}-\{version}-src"
  @fs.mkdir(source, recursive=true)
  sandbox.write(
    "\{source}/package.json",
    "{\"name\":\"\{name}\",\"version\":\"\{version}\"}",
  )
  sandbox.write("\{source}/index.js", "module.exports=1\n")
  ignore(
    sandbox.must(
      "npm",
      ["pack", "--silent", "--pack-destination", "\{sandbox.root}/pkgs"],
      cwd=source,
    ),
  )
}

///|
async fn make_npm_repo(
  sandbox : Sandbox,
  name : String,
  node_version? : String,
) -> Unit {
  let seed = "\{sandbox.root}/seed-\{name}"
  @fs.mkdir("\{seed}/bin", recursive=true)
  ignore(sandbox.git(seed, ["init", "-q", "-b", "review", "."]))
  let pkgs = "\{sandbox.root}/pkgs"
  sandbox.write("\{seed}/.gitignore", "node_modules\n")
  let manifest = (package_name : String, dependency : String, tarball : String) => {
    "{\"name\":\"\{package_name}\",\"version\":\"1.0.0\",\"dependencies\":{\"\{dependency}\":\"file:\{pkgs}/\{tarball}\"}}"
  }
  sandbox.write(
    "\{seed}/package.json",
    manifest("app", "dep-a", "dep-a-1.0.0.tgz"),
  )
  sandbox.write(
    "\{seed}/bin/package.json",
    manifest("bin", "dep-b", "dep-b-1.0.0.tgz"),
  )
  ignore(sandbox.must("npm", ["install", "-s"], cwd=seed))
  ignore(sandbox.must("npm", ["install", "-s"], cwd="\{seed}/bin"))
  if node_version is Some(version) {
    sandbox.write("\{seed}/.node-version", version + "\n")
  }
  ignore(sandbox.git(seed, ["add", "-A"]))
  ignore(sandbox.git(seed, ["commit", "-qm", "init"]))
  for branch in ["b1", "b2", "b3", "b5", "c1", "c2", "c3", "d1", "d2"] {
    ignore(sandbox.git(seed, ["branch", branch]))
  }
  ignore(sandbox.git(seed, ["checkout", "-q", "-b", "b4"]))
  sandbox.write(
    "\{seed}/package.json",
    manifest("app", "dep-a", "dep-a-2.0.0.tgz"),
  )
  ignore(sandbox.must("npm", ["install", "-s"], cwd=seed))
  ignore(sandbox.git(seed, ["commit", "-qam", "v2"]))
  ignore(sandbox.git(seed, ["checkout", "-q", "review"]))
  ignore(
    sandbox.git(seed, [
      "clone",
      "-q",
      "--bare",
      ".",
      "\{sandbox.root}/remotes/\{name}.git",
    ]),
  )
}

///|
/// `.node-version` の検証用に、現在の node とメジャーが異なる nodenv のインストール済みバージョン。
async fn alternative_node_version(sandbox : Sandbox) -> String? {
  guard sandbox.env.get("NODENV_ROOT") is Some(nodenv_root) else { return None }
  let current = sandbox.must("node", ["-p", "process.versions.node"])
  let current_major = current.split(".").next().map(part => part.to_owned())
  let versions = @fs.readdir("\{nodenv_root}/versions") catch {
    _ => return None
  }
  versions.sort_by((left, right) => left.lexical_compare(right))
  versions
  .iter()
  .find_first(version => {
    version.split(".").next().map(part => part.to_owned()) != current_major
  })
}

///|
async fn NpmFixture::new() -> NpmFixture {
  let sandbox = Sandbox::new()
  @fs.mkdir("\{sandbox.root}/remotes", recursive=true)
  @fs.mkdir("\{sandbox.root}/fakebin", recursive=true)
  @fs.mkdir("\{sandbox.root}/outside/p", recursive=true)
  let npm_log = "\{sandbox.root}/npm.log"
  let real_npm = find_in_path(sandbox, "npm")
  let wrapper = "\{sandbox.root}/fakebin/npm"
  sandbox.write(
    wrapper,
    "#!/bin/bash\necho \"$PWD :: $*\" >> \"\{npm_log}\"\nexec \"\{real_npm}\" \"$@\"\n",
  )
  @fs.chmod(wrapper, 0o755)
  sandbox.env.set(
    "PATH",
    "\{sandbox.root}/fakebin:\{sandbox.env.get("PATH").unwrap_or("")}",
  )
  make_package(sandbox, "dep-a", "1.0.0")
  make_package(sandbox, "dep-a", "2.0.0")
  make_package(sandbox, "dep-b", "1.0.0")
  make_npm_repo(sandbox, "npmrepo")
  sandbox.write(npm_log, "")
  ignore(sandbox.ws(["new", "t1"]))
  ignore(sandbox.ws(["clone", "file://\{sandbox.root}/remotes/npmrepo.git"]))
  { sandbox, npm_log, tasks: "\{sandbox.ws_root}/tasks", }
}

///|
async fn NpmFixture::npm_runs(self : NpmFixture) -> Int32 {
  @fs.read_text(self.npm_log).split("\n").filter(line => line != "").count()
}

///|
async fn NpmFixture::cache_entries(self : NpmFixture) -> String {
  let root = "\{self.sandbox.ws_root}/.cache/node_modules"
  if !@fs.exists(root) {
    return ""
  }
  let entries = @fs.readdir(root, include_hidden=true)
  entries.sort_by((left, right) => left.lexical_compare(right))
  self.sandbox.normalize(entries.join(" "))
}

///|
async fn NpmFixture::marker(self : NpmFixture, worktree : String) -> String {
  @fs.read_text("\{self.tasks}/\{worktree}/node_modules/.ws-cache-key") catch {
    _ => "<none>"
  }
}

///|
async fn NpmFixture::ws(
  self : NpmFixture,
  args : Array[String],
  cwd? : String,
) -> String {
  let timing = @string.Regex("added 1 package in [0-9.]+m?s") catch {
    _ => panic()
  }
  timing
  .replace_by(self.sandbox.ws(args, cwd?).render(), _ => "added 1 package")
  .to_owned()
}

///|
async fn wait_until_trash_is_empty(sandbox : Sandbox) -> Int32 {
  let trash = "\{sandbox.ws_root}/.cache/trash"
  for _ in 0..<100 {
    if !@fs.exists(trash) ||
      @fs.readdir(trash, include_hidden=true).length() == 0 {
      return 0
    }
    @async.sleep(100)
  }
  @fs.readdir(trash, include_hidden=true).length()
}

///|
async test "node_modules cache via add and npm ci" {
  let log = Transcript::new()
  let fixture = NpmFixture::new()
  let sandbox = fixture.sandbox
  defer sandbox.cleanup()
  let tasks = fixture.tasks

  log.record(
    fixture.ws(["add", "--task", "t1", "--repo", "npmrepo", "--branch", "b1"]),
  )
  log.record(fixture.npm_runs())
  log.record(fixture.cache_entries())
  log.record(
    @fs.exists("\{tasks}/t1/npmrepo--b1/bin/node_modules/dep-b/package.json"),
  )
  let key = fixture.marker("t1/npmrepo--b1")

  log.record(
    fixture.ws(["add", "--task", "t1", "--repo", "npmrepo", "--branch", "b2"]),
  )
  log.record(fixture.npm_runs())
  log.record(fixture.marker("t1/npmrepo--b2") == key)

  log.record(
    fixture.ws([
      "add", "--task", "t1", "--repo", "npmrepo", "--no-install", "--branch", "b3",
    ]),
  )
  log.record(@fs.exists("\{tasks}/t1/npmrepo--b3/node_modules"))

  log.record(
    fixture.ws([
      "add", "--task", "t1", "--repo", "npmrepo", "--readonly", "--branch", "b5",
    ]),
  )
  log.record(fixture.npm_runs())

  log.record(fixture.ws(["npm", "ci"], cwd="\{tasks}/t1/npmrepo--b3/bin"))
  log.record(fixture.ws(["npm", "ci"], cwd="\{tasks}/t1/npmrepo--b3"))
  log.record(fixture.ws(["npm", "ci"], cwd="\{tasks}/t1/npmrepo--b2"))
  log.record(fixture.npm_runs())
  log.record(wait_until_trash_is_empty(sandbox))

  @fs.rmdir("\{tasks}/t1/npmrepo--b3/node_modules", recursive=true)
  log.record(
    fixture.ws(
      ["npm", "ci", "--", "--offline", "--dry-run"],
      cwd="\{tasks}/t1/npmrepo--b3",
    ),
  )
  let last_npm_call = @fs.read_text(fixture.npm_log)
    .trim_end()
    .split("\n")
    .last()
  log.record(
    sandbox.normalize(last_npm_call.map(line => line.to_owned()).unwrap_or("")),
  )
  log.record(@fs.exists("\{tasks}/t1/npmrepo--b3/node_modules"))
  ignore(fixture.ws(["npm", "ci"], cwd="\{tasks}/t1/npmrepo--b3"))
  log.record(@fs.exists("\{tasks}/t1/npmrepo--b3/node_modules/dep-a"))

  ignore(
    fixture.ws([
      "add", "--task", "t1", "--repo", "npmrepo", "--no-install", "--branch", "b4",
    ]),
  )
  let before = fixture.npm_runs()
  log.record(fixture.ws(["npm", "ci"], cwd="\{tasks}/t1/npmrepo--b4"))
  log.record(fixture.npm_runs() - before)
  log.record(fixture.cache_entries())

  log.record(fixture.ws(["npm", "ci"], cwd="\{sandbox.root}/outside"))
  sandbox.write("\{sandbox.root}/outside/p/package.json", "{}")
  log.record(fixture.ws(["npm", "ci"], cwd="\{sandbox.root}/outside/p"))
  inspect(
    log.text(),
    content=(
      #|作成しました: $S/root/tasks/t1/npmrepo--b1
      #|
      #|added 1 package
      #|npm ci を実行しキャッシュに登録しました: $S/root/tasks/t1/npmrepo--b1
      #|
      #|added 1 package
      #|npm ci を実行しキャッシュに登録しました: $S/root/tasks/t1/npmrepo--b1/bin
      #|rc=0
      #|2
      #|<sha256>-abi<node> <sha256>-abi<node>
      #|true
      #|作成しました: $S/root/tasks/t1/npmrepo--b2
      #|キャッシュから復元しました (clonefile): $S/root/tasks/t1/npmrepo--b2
      #|キャッシュから復元しました (clonefile): $S/root/tasks/t1/npmrepo--b2/bin
      #|rc=0
      #|2
      #|true
      #|作成しました: $S/root/tasks/t1/npmrepo--b3
      #|rc=0
      #|false
      #|作成しました: $S/root/tasks/t1/_readonly/npmrepo--b5
      #|キャッシュから復元しました (clonefile): $S/root/tasks/t1/_readonly/npmrepo--b5
      #|キャッシュから復元しました (clonefile): $S/root/tasks/t1/_readonly/npmrepo--b5/bin
      #|rc=0
      #|2
      #|キャッシュから復元しました (clonefile): $S/root/tasks/t1/npmrepo--b3/bin
      #|rc=0
      #|キャッシュから復元しました (clonefile): $S/root/tasks/t1/npmrepo--b3
      #|rc=0
      #|キャッシュから復元しました (clonefile): $S/root/tasks/t1/npmrepo--b2
      #|rc=0
      #|2
      #|0
      #|add dep-a 1.0.0
      #|
      #|added 1 package
      #|npm ci を実行しました: $S/root/tasks/t1/npmrepo--b3
      #|rc=0
      #|$S/root/tasks/t1/npmrepo--b3 :: ci --offline --dry-run
      #|false
      #|true
      #|
      #|added 1 package
      #|npm ci を実行しキャッシュに登録しました: $S/root/tasks/t1/npmrepo--b4
      #|rc=0
      #|1
      #|<sha256>-abi<node> <sha256>-abi<node> <sha256>-abi<node>
      #|! ws: package.json が見つかりません
      #|rc=1
      #|! ws: $S/outside/p に package-lock.json がありません
      #|rc=1
      #|
    ),
  )
}

///|
async test "add reports npm ci failure but keeps the worktree" {
  let log = Transcript::new()
  let fixture = NpmFixture::new()
  let sandbox = fixture.sandbox
  defer sandbox.cleanup()
  let seed = "\{sandbox.root}/seed-npmrepo"
  ignore(sandbox.git(seed, ["checkout", "-q", "-b", "b6", "review"]))
  for file in ["package.json", "package-lock.json"] {
    let text = @fs.read_text("\{seed}/\{file}")
    sandbox.write(
      "\{seed}/\{file}",
      text.replace_all(old="dep-a-1.0.0.tgz", new="nonexistent-9.tgz"),
    )
  }
  ignore(sandbox.git(seed, ["commit", "-qam", "broken"]))
  ignore(sandbox.git(seed, ["push", "-q", "../remotes/npmrepo.git", "b6"]))
  ignore(
    sandbox.git("\{sandbox.ws_root}/repos/npmrepo.git", [
      "fetch", "-q", "origin",
    ]),
  )
  let outcome = sandbox.ws([
    "add", "--task", "t1", "--repo", "npmrepo", "--branch", "b6",
  ])
  let warnings = outcome.stderr
    .split("\n")
    .filter(line => line.has_prefix("warn:") || line.has_prefix("  再実行"))
    .map(line => line.to_owned())
    .collect()
  log.record(warnings.join("\n"))
  log.record(outcome.code)
  log.record(@fs.exists("\{fixture.tasks}/t1/npmrepo--b6/package.json"))
  inspect(
    log.text(),
    content=(
      #|warn: npm ci に失敗しました: $S/root/tasks/t1/npmrepo--b6
      #|  再実行: cd $S/root/tasks/t1/npmrepo--b6 && ws npm ci
      #|1
      #|true
      #|
    ),
  )
}

///|
async test "node version from .node-version selects the cache ABI" {
  let log = Transcript::new()
  let fixture = NpmFixture::new()
  let sandbox = fixture.sandbox
  defer sandbox.cleanup()
  guard alternative_node_version(sandbox) is Some(version) else { return }
  make_npm_repo(sandbox, "nvrepo", node_version=version)
  ignore(sandbox.ws(["clone", "file://\{sandbox.root}/remotes/nvrepo.git"]))
  ignore(
    fixture.ws(["add", "--task", "t1", "--repo", "npmrepo", "--branch", "b1"]),
  )
  let current = sandbox.must("node", ["-p", "process.versions.node"])
  sandbox.env.set("NODENV_VERSION", current)
  sandbox.env.set("NODENV_DIR", sandbox.root)
  let outcome = sandbox.ws([
    "add", "--task", "t1", "--repo", "nvrepo", "--branch", "b1",
  ])
  log.record(outcome.code)
  sandbox.env.remove("NODENV_VERSION")
  sandbox.env.remove("NODENV_DIR")
  let expected_abi = sandbox.must(
    "node",
    ["-p", "process.versions.modules"],
    cwd="\{fixture.tasks}/t1/nvrepo--b1",
  )
  let current_abi = sandbox.must("node", ["-p", "process.versions.modules"])
  let marker = fixture.marker("t1/nvrepo--b1")
  log.record(expected_abi != current_abi)
  log.record(marker.contains("-abi\{expected_abi}-"))
  inspect(
    log.text(),
    content=(
      #|0
      #|true
      #|true
      #|
    ),
  )
}
