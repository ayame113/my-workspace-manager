///|
/// npm 実行をログに記録するラッパーを PATH に置き、file: 依存のパッケージと npm 用 remote を用意する。
async fn Sandbox::setup_npm(self : Sandbox) -> Unit {
  let real_npm = self.must("/usr/bin/which", ["npm"])
  @fs.mkdir("\{self.root}/fakebin")
  write(
    "\{self.root}/fakebin/npm",
    "#!/bin/bash\necho \"$PWD :: $*\" >> \"\{self.root}/npm.log\"\nexec \"\{real_npm}\" \"$@\"\n",
  )
  @fs.chmod("\{self.root}/fakebin/npm", 0o755)
  self.env["PATH"] = "\{self.root}/fakebin:\{self.env.get("PATH").unwrap_or("")}"
  for dependency in [("dep-a", "1.0.0"), ("dep-a", "2.0.0"), ("dep-b", "1.0.0")] {
    let (name, version) = dependency
    let source = "\{self.root}/pkgs/\{name}-\{version}"
    @fs.mkdir(source, recursive=true)
    write(
      "\{source}/package.json",
      "{\"name\":\"\{name}\",\"version\":\"\{version}\"}",
    )
    ignore(
      self.must(
        "npm",
        ["pack", "--silent", "--pack-destination", "\{self.root}/pkgs"],
        cwd=source,
      ),
    )
  }
  self.make_npm_remote("npmrepo")
  write("\{self.root}/npm.log", "")
  self.setup_ws(["new", "t1"])
}

///|
fn Sandbox::manifest(
  self : Sandbox,
  name : String,
  dependency : String,
) -> String {
  "{\"name\":\"\{name}\",\"version\":\"1.0.0\",\"dependencies\":{\"\{dependency.split("@").next().unwrap()}\":\"file:\{self.root}/pkgs/\{dependency.replace(old="@", new="-")}.tgz\"}}"
}

///|
/// ルートと bin/ に lockfile を持つ remote。ブランチ b4 だけ dep-a が 2.0.0。
async fn Sandbox::make_npm_remote(
  self : Sandbox,
  name : String,
  node_version? : String,
) -> Unit {
  let seed = "\{self.root}/seed-\{name}"
  @fs.mkdir("\{seed}/bin", recursive=true)
  ignore(self.git(seed, ["init", "-q", "."]))
  write("\{seed}/.gitignore", "node_modules\n")
  write("\{seed}/package.json", self.manifest("app", "dep-a@1.0.0"))
  write("\{seed}/bin/package.json", self.manifest("bin", "dep-b@1.0.0"))
  ignore(self.must("npm", ["install", "-s"], cwd=seed))
  ignore(self.must("npm", ["install", "-s"], cwd="\{seed}/bin"))
  if node_version is Some(version) {
    write("\{seed}/.node-version", version)
  }
  ignore(self.git(seed, ["add", "-A"]))
  ignore(self.git(seed, ["commit", "-qm", "init"]))
  ignore(self.git(seed, ["checkout", "-q", "-b", "b4"]))
  write("\{seed}/package.json", self.manifest("app", "dep-a@2.0.0"))
  ignore(self.must("npm", ["install", "-s"], cwd=seed))
  ignore(self.git(seed, ["commit", "-qam", "v2"]))
  ignore(self.git(seed, ["checkout", "-q", "review"]))
  self.make_remote(name, ["b1", "b2", "b3", "b5", "c1", "c2", "c3", "d1", "d2"])
}

///|
async fn Sandbox::npm_runs(self : Sandbox) -> Int32 {
  @fs.read_text("\{self.root}/npm.log")
  .split("\n")
  .filter(line => line != "")
  .count()
}

///|
async fn Sandbox::cache_entries(self : Sandbox) -> String {
  let root = "\{self.ws_root}/.cache/node_modules"
  self.normalize(
    if @fs.exists(root) {
      @fs.readdir(root).length().to_string()
    } else {
      "0"
    },
  )
}

///|
async fn Sandbox::marker(self : Sandbox, worktree : String) -> String {
  @fs.read_text("\{self.tasks}/\{worktree}/node_modules/.ws-cache-key") catch {
    _ => "<none>"
  }
}

///|
async test "node_modules cache via add and npm ci" {
  let s = Sandbox::new()
  defer s.cleanup()
  s.setup_npm()
  let t1 = "\{s.tasks}/t1"
  let add = (args : Array[String]) => {
    s.ws(["add", "--task", "t1", "--repo", "npmrepo", ..args])
  }
  ignore(add(["--branch", "b1"]))
  s.note("npm runs: \{s.npm_runs()}, cache entries: \{s.cache_entries()}")
  ignore(add(["--branch", "b2"]))
  ignore(s.ws(["npm", "ci"], cwd="\{t1}/npmrepo--b1"))
  ignore(add(["--readonly", "--branch", "b5"]))
  s.note(
    "npm runs: \{s.npm_runs()}, same marker: \{s.marker("t1/npmrepo--b2") == s.marker("t1/npmrepo--b1")}",
  )
  ignore(add(["--no-install", "--branch", "b3"]))
  s.note(
    "node_modules after --no-install: \{@fs.exists("\{t1}/npmrepo--b3/node_modules")}",
  )
  ignore(s.ws(["npm", "ci"], cwd="\{t1}/npmrepo--b3/bin"))
  ignore(s.ws(["npm", "ci"], cwd="\{t1}/npmrepo--b2"))
  s.note("npm runs: \{s.npm_runs()}")
  ignore(s.ws(["npm", "ci", "--", "--dry-run"], cwd="\{t1}/npmrepo--b3"))
  s.note(
    "node_modules after --dry-run: \{@fs.exists("\{t1}/npmrepo--b3/node_modules")}",
  )
  s.setup_ws([
    "add", "--task", "t1", "--repo", "npmrepo", "--no-install", "--branch", "b4",
  ])
  ignore(s.ws(["npm", "ci"], cwd="\{t1}/npmrepo--b4"))
  s.note("npm runs: \{s.npm_runs()}, cache entries: \{s.cache_entries()}")
  ignore(s.ws(["npm", "ci"], cwd="\{s.root}/outside"))
  write("\{s.root}/outside/p/package.json", "{}")
  ignore(s.ws(["npm", "ci"], cwd="\{s.root}/outside/p"))

  let seed = "\{s.root}/seed-npmrepo"
  ignore(s.git(seed, ["checkout", "-q", "-b", "broken", "review"]))
  for file in ["package.json", "package-lock.json"] {
    write(
      "\{seed}/\{file}",
      @fs.read_text("\{seed}/\{file}").replace_all(
        old="dep-a-1.0.0",
        new="missing-9",
      ),
    )
  }
  ignore(s.git(seed, ["commit", "-qam", "broken"]))
  ignore(s.git(seed, ["push", "-q", "../remotes/npmrepo.git", "broken"]))
  ignore(s.git("\{s.ws_root}/repos/npmrepo.git", ["fetch", "-q", "origin"]))
  ignore(add(["--branch", "broken"]))
  s.note("worktree kept: \{@fs.exists("\{t1}/npmrepo--broken/package.json")}")
  inspect(
    s.transcript.to_string(),
    content=(
      #|作成しました: $S/root/tasks/t1/npmrepo--b1
      #|
      #|added 1 package
      #|npm ci を実行しキャッシュに登録しました: $S/root/tasks/t1/npmrepo--b1
      #|
      #|added 1 package
      #|npm ci を実行しキャッシュに登録しました: $S/root/tasks/t1/npmrepo--b1/bin
      #|rc=0
      #|npm runs: 2, cache entries: 2
      #|作成しました: $S/root/tasks/t1/npmrepo--b2
      #|キャッシュから復元しました: $S/root/tasks/t1/npmrepo--b2
      #|キャッシュから復元しました: $S/root/tasks/t1/npmrepo--b2/bin
      #|rc=0
      #|node_modules は既に最新です: $S/root/tasks/t1/npmrepo--b1
      #|rc=0
      #|作成しました: $S/root/tasks/t1/_readonly/npmrepo--b5
      #|キャッシュから復元しました: $S/root/tasks/t1/_readonly/npmrepo--b5
      #|キャッシュから復元しました: $S/root/tasks/t1/_readonly/npmrepo--b5/bin
      #|rc=0
      #|npm runs: 2, same marker: true
      #|作成しました: $S/root/tasks/t1/npmrepo--b3
      #|rc=0
      #|node_modules after --no-install: false
      #|キャッシュから復元しました: $S/root/tasks/t1/npmrepo--b3/bin
      #|rc=0
      #|node_modules は既に最新です: $S/root/tasks/t1/npmrepo--b2
      #|rc=0
      #|npm runs: 2
      #|add dep-a 1.0.0
      #|
      #|added 1 package
      #|npm ci を実行しました: $S/root/tasks/t1/npmrepo--b3
      #|rc=0
      #|node_modules after --dry-run: false
      #|
      #|added 1 package
      #|npm ci を実行しキャッシュに登録しました: $S/root/tasks/t1/npmrepo--b4
      #|rc=0
      #|npm runs: 4, cache entries: 3
      #|! ws: package.json が見つかりません
      #|rc=1
      #|! ws: $S/outside/p に package-lock.json がありません
      #|rc=1
      #|作成しました: $S/root/tasks/t1/npmrepo--broken
      #|キャッシュから復元しました: $S/root/tasks/t1/npmrepo--broken/bin
      #|! warn: npm ci に失敗しました: $S/root/tasks/t1/npmrepo--broken
      #|rc=1
      #|worktree kept: true
      #|
    ),
  )
}

///|
async test "node version from .node-version selects the cache ABI" {
  let s = Sandbox::new()
  defer s.cleanup()
  // 現在の node とメジャーが異なる nodenv のバージョンが無ければ検証できない
  guard s.env.get("NODENV_ROOT") is Some(nodenv_root) else { return }
  let major = (version : String) => {
    version.split(".").next().map(part => part.to_owned())
  }
  let current = s.must("node", ["-p", "process.versions.node"])
  let versions = @fs.readdir("\{nodenv_root}/versions") catch { _ => return }
  guard versions.iter().find_first(version => major(version) != major(current))
    is Some(version) else {
    return
  }
  s.setup_npm()
  s.make_npm_remote("nvrepo", node_version=version)
  s.setup_ws(["add", "--task", "t1", "--repo", "nvrepo", "--branch", "b1"])
  let abi = s.must(
    "node",
    ["-p", "process.versions.modules"],
    cwd="\{s.tasks}/t1/nvrepo--b1",
  )
  inspect(
    abi != s.must("node", ["-p", "process.versions.modules"]),
    content="true",
  )
  inspect(s.marker("t1/nvrepo--b1").contains("-abi\{abi}-"), content="true")
}
